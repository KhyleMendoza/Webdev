<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>World Food Data</h1>
    <form action="/filter" method="GET">
        <input type="text" name="country" placeholder="Search Country...">
        <button type="submit">Search</button>
    </form>
    <hr>
    
    <h2>Production Overview</h2>
    <div>
        <div>
            <h3>Countries</h3>
            <p><%= data.length %></p>
        </div>

        <div>
            <h3>Total Rice Production</h3>
            <p>
                <%= data.reduce((total, item) => total + Number(item.rice_production), 0).toFixed(2) %>
            </p>
        </div>

        <div>
            <h3>Total Wheat Production</h3>
            <p>
                <%= data.reduce((total, item) => total + Number(item.wheat_production), 0).toFixed(2) %>
            </p>
        </div>
    </div>
    <hr>

    <h2>Top Producers</h2>

    <div>
        <div>
            <h3>Top Rice Producer</h3>
            <p><%= topRiceProducer.country %></p>
            <p><%= topRiceProducer.rice_production %></p>
        </div>

        <div>
            <h3>Top Wheat Producer</h3>
            <p><%= topWheatProducer.country %></p>
            <p><%= topWheatProducer.wheat_production %></p>
        </div>
    </div>
    <hr>

    <h2>Country Data</h2>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Country</th>
                <th>Rice Production</th>
                <th>Wheat Production</th>
            </tr>
        </thead>

        <tbody>
            <% data.forEach((item) => { %>
                <tr>
                    <td><%= item.id %></td>
                    <td><%= item.country %></td>
                    <td><%= item.rice_production %></td>
                    <td><%= item.wheat_production %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</body>
</html>