<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SQL LITE</title>
</head>
<body>
    <% if (locals.products) { %>
        <h1>Product Table</h1>
        <table>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
            </tr>
            <% products.forEach((product) => {%>
                <tr>
                    <td><%= product.id %></td>
                    <td><%= product.name %></td>
                    <td><%= product.price %></td>
                </tr>
            <% }); %>
        </table>
    <% } else { %>
        <p>No data Found</p>
    <% } %>
</body>
</html>